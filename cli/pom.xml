<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.migrationagent</groupId>
    <artifactId>migration-agent-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cli</artifactId>
  <packaging>jar</packaging>
  <name>cli</name>
  <description>picocli entrypoint wiring sandbox + buildparse together</description>

  <dependencies>
    <dependency>
      <groupId>io.migrationagent</groupId>
      <artifactId>sandbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.migrationagent</groupId>
      <artifactId>buildparse</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.migrationagent</groupId>
      <artifactId>rewrite</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.migrationagent</groupId>
      <artifactId>llm</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.migrationagent</groupId>
      <artifactId>agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.migrationagent</groupId>
      <artifactId>guardrails</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.migrationagent</groupId>
      <artifactId>eval</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>migration-agent</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.migrationagent.cli.MigrationAgentCli</mainClass>
                </transformer>
              </transformers>
              <filters>
                <!-- Strip signature files from shaded dependency jars — without
                     this, merging a signed jar's classes under a new combined
                     manifest trips "Invalid signature file digest" at runtime. -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
