# Copy to .env and fill in real values. .env is gitignored — never commit it.
# These are read only by the llm module (Phase 3+), only on the host, and
# are never mounted into the Docker sandbox or logged. See docs/DESIGN.md
# section 1.2 and 13.
#
# Bring your own key: none of this is hardcoded to these specific keys.
# Fill in whichever of these you have, enable the matching provider in
# config/providers.yaml, and `migrate`/`evaluate` will use it. You can also
# point entirely at your own copies of this file and providers.yaml via
# --env-file / --providers-config, without touching the committed ones.

GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
